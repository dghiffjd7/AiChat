      "entries": [
        {
          "id": "雾港通行规则",
          "title": "雾港通行规则",
          "keys": [],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 100,
          "position": 0,
          "contentLength": 115,
          "sourceLayer": "user_original",
          "sourceRefs": [
            "user_request"
          ],
          "content": "潮雾弥漫之际，雾港通行以蓝塔为引。凡进港船只，须循蓝色灯塔光束指引航路，并以三短一长鸣笛为通航信号，未鸣者不予回应。船抵码头后，守夜人登船核验通行凭证，确认无误方可放行；无证或不符者，须原地候查，不得擅自登岸。雾中行船，礼序为先。",
          "contentTruncated": false
        }
      ],
      "truncated": false
    },
    "V4F-V2导入卡资料-0731": {
      "ok": true,
      "id": "V4F-V2导入卡资料-0731",
      "name": "V4F-V2导入卡资料-0731",
      "entryCount": 14,
      "boundToCurrentSession": false,
      "global": false,
      "contentMode": "content",
      "contentHint": "",
      "returnedEntryCount": 14,
      "entries": [
        {
          "id": "艾琳·洛",
          "title": "艾琳·洛",
          "keys": [
            "艾琳",
            "调查队长"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 100,
          "position": 0,
          "contentLength": 39,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "艾琳·洛是霜港调查队长，冷静果断，擅长航海与现场判断，是长期故事中的主要人物。",
          "contentTruncated": false
        },
        {
          "id": "顾风",
          "title": "顾风",
          "keys": [
            "顾风",
            "机关师"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 101,
          "position": 0,
          "contentLength": 41,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "顾风是调查队机关师，谨慎寡言，负责修理设备与破解遗迹机关，是长期故事中的主要人物。",
          "contentTruncated": false
        },
        {
          "id": "米娅",
          "title": "米娅",
          "keys": [
            "米娅",
            "向导"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 102,
          "position": 0,
          "contentLength": 35,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "米娅是熟悉霜港街巷与潮汐的年轻向导，外向敏锐，是长期故事中的主要人物。",
          "contentTruncated": false
        },
        {
          "id": "霜港概览",
          "title": "霜港概览",
          "keys": [
            "霜港",
            "城市"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 103,
          "position": 0,
          "contentLength": 26,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "霜港终年受潮雾笼罩，港区、旧城与灯塔区构成主要舞台。",
          "contentTruncated": false
        },
        {
          "id": "蓝焰灯塔",
          "title": "蓝焰灯塔",
          "keys": [
            "灯塔",
            "蓝焰"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 104,
          "position": 0,
          "contentLength": 27,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "蓝焰灯塔每逢退潮会发出异常光芒，是调查主线的重要地点。",
          "contentTruncated": false
        },
        {
          "id": "潮汐规则",
          "title": "潮汐规则",
          "keys": [
            "潮汐",
            "通行"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 105,
          "position": 0,
          "contentLength": 27,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "船只靠岸前必须鸣笛三短一长，夜间仅持证者可以进入旧港。",
          "contentTruncated": false
        },
        {
          "id": "调查队守则",
          "title": "调查队守则",
          "keys": [
            "守则",
            "规则"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 106,
          "position": 0,
          "contentLength": 32,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "调查必须两人同行，发现未知遗物时先记录、隔离，再交由机关师检查。",
          "contentTruncated": false
        },
        {
          "id": "旧港遗迹",
          "title": "旧港遗迹",
          "keys": [
            "遗迹",
            "旧港"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 107,
          "position": 0,
          "contentLength": 25,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "旧港地下保存着失落航线的石刻与多处尚未开启的密室。",
          "contentTruncated": false
        },
        {
          "id": "输出格式",
          "title": "输出格式",
          "keys": [
            "格式",
            "对话"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 108,
          "position": 0,
          "contentLength": 29,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "角色聊天使用 APP 既有私聊协议，不要求额外自定义标签。",
          "contentTruncated": false
        },
        {
          "id": "用户边界",
          "title": "用户边界",
          "keys": [
            "用户",
            "边界"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 109,
          "position": 0,
          "contentLength": 30,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "用户是刚加入调查队的新成员；不得替用户决定行动、关系或背景。",
          "contentTruncated": false
        },
        {
          "id": "时间线",
          "title": "时间线",
          "keys": [
            "时间",
            "序章"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 110,
          "position": 0,
          "contentLength": 22,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "故事从蓝焰灯塔连续三夜异常点亮后的清晨开始。",
          "contentTruncated": false
        },
        {
          "id": "资料来源说明",
          "title": "资料来源说明",
          "keys": [
            "来源",
            "测试"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 111,
          "position": 0,
          "contentLength": 35,
          "sourceLayer": "",
          "sourceRefs": [],
          "content": "以上均为 V4F-V2 冻结观察用原创测试资料，不属于任何正式角色卡。",
          "contentTruncated": false
        },
        {
          "id": "雾潮预警",
          "title": "雾潮预警",
          "keys": [
            "雾潮",
            "预警",
            "霜港"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 100,
          "position": 0,
          "contentLength": 125,
          "sourceLayer": "user_original",
          "sourceRefs": [
            "user_request"
          ],
          "content": "霜港近海周期性弥漫灰白色雾潮，浓时遮蔽视线，干扰罗盘与通讯，潮中常伴随低语。观测站依强度分蓝、黄、红三色预警：蓝色戒备，黄色管制，红色封锁。雾潮逼近时，村民须沿固定路线撤离至高地；调查队则就地转入防护状态，停止一切外出勘测，待雾潮消退后方可恢复作业。",
          "contentTruncated": false
        },
        {
          "id": "遗迹勘察流程",
          "title": "遗迹勘察流程",
          "keys": [
            "遗迹",
            "勘察",
            "流程"
          ],
          "secondaryKeys": [],
          "disabled": false,
          "constant": true,
          "order": 101,
          "position": 0,
          "contentLength": 138,
          "sourceLayer": "user_original",
          "sourceRefs": [
            "user_request"
          ],
          "content": "霜港周边遗迹勘察按标准化流程执行。第一步，外围测绘并拓印符文，同步开展机关、毒气与塌方安全检查。确认安全后，分组进入，每组须标记行进路径并严格遵循返回时限。发现异常古物时，不得擅自带回，须当场封装、登记造册。勘察结束后，全部物品统一移交观测站归档，个人禁止留存任何取样或拓片。",
          "contentTruncated": false
        }
      ],
      "truncated": false
    },
